# ML Swarm API - POST endpoint that accepts { "query": "..." }
ML_SWARM_URL=http://localhost:9001/api/swarm/analyze

# MedGemma API - POST endpoint that accepts { "query": "..." }
MEDGEMMA_URL=http://localhost:9002/api/medgemma/analyze

# Groq API Key - for the Synthesis Agent LLM
GROQ_API_KEY=gsk_your_key_here

# Groq Model - which model to use for synthesis
GROQ_MODEL=llama-3.3-70b-versatile

# Server
HOST=0.0.0.0
PORT=8000
